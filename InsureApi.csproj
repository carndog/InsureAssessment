<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="InsuranceDomain\InsuranceDomain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="InsuranceDomain\**\*.cs" />
      <Compile Remove="Tests\**\*.cs" />
      <EmbeddedResource Remove="InsuranceDomain\**\*.resx" />
      <EmbeddedResource Remove="Tests\**\*.resx" />
      <None Remove="InsuranceDomain\**\*" />
      <None Remove="Tests\**\*" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="InsureApi.Tests\obj\InsureApi.Tests.csproj.nuget.dgspec.json" />
      <_ContentIncludedByDefault Remove="InsureApi.Tests\obj\project.assets.json" />
    </ItemGroup>

</Project>
