@baseUrl = http://localhost:5078
# Note: This flow uses the development policy POL-RENEW-DEMO for testing renewal functionality

### Renew a Policy
< {%
    const today = new Date();
    const renewalStartDate = new Date(today);
    renewalStartDate.setDate(renewalStartDate.getDate() + 30);
    const renewalEndDate = new Date(renewalStartDate);
    renewalEndDate.setFullYear(renewalEndDate.getFullYear() + 1);

    const formatDate = (date) => date.toISOString().split('T')[0];

    request.variables.set("renewalStartDate", formatDate(renewalStartDate));
    request.variables.set("renewalEndDate", formatDate(renewalEndDate));
%}

POST {{baseUrl}}/api/policies/POL-RENEW-DEMO/renewals
Content-Type: application/json

{
  "StartDate": "{{renewalStartDate}}",
  "EndDate": "{{renewalEndDate}}",
  "Amount": 525.00
}
