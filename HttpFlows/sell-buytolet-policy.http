@baseUrl = http://localhost:5078

### Step 1: Create Customer
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "FirstName": "Jane",
  "LastName": "Smith",
  "DateOfBirth": "1985-05-20"
}

> {%
    client.test("Customer created successfully", function() {
        client.assert(response.status === 201, "Response status is 201");
        client.global.set("customerId", response.body.CustomerId);
    });
%}

###

### Step 2: Create Address
POST {{baseUrl}}/api/addresses
Content-Type: application/json

{
  "AddressLine1": "456 Oak Avenue",
  "AddressLine2": null,
  "AddressLine3": "Suburb",
  "Postcode": "EF34GH"
}

> {%
    client.test("Address created successfully", function() {
        client.assert(response.status === 201, "Response status is 201");
        client.global.set("addressId", response.body.AddressId);
    });
%}

###

### Step 3: Sell BuyToLet Policy
POST {{baseUrl}}/api/policies/buytolet
Content-Type: application/json

> {%
    const today = new Date();
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);
    const nextYear = new Date(tomorrow);
    nextYear.setFullYear(nextYear.getFullYear() + 1);

    const formatDate = (date) => date.toISOString().split('T')[0];

    client.global.set("startDate", formatDate(tomorrow));
    client.global.set("endDate", formatDate(nextYear));
%}

{
  "StartDate": "{{startDate}}",
  "EndDate": "{{endDate}}",
  "Amount": 750.00,
  "AutoRenew": true,
  "CustomerIds": ["{{customerId}}"],
  "AddressId": "{{addressId}}",
  "Payment": {
    "PaymentReference": "PAY-002",
    "Type": "DirectDebit",
    "Amount": 750.00
  }
}

> {%
    client.test("Policy created successfully", function() {
        client.assert(response.status === 201, "Response status is 201");
        client.global.set("policyReference", response.body.UniqueReference);
    });
%}
